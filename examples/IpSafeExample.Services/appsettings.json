{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "qckdev.AspNetCore.Mvc.Filters.IpSafe": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "ForwardedHeaders": {
      "ForwardedHeaders": "XForwardedFor, XForwardedProto",
      "ForwardLimit": 1,
      "KnownProxies": "127.0.0.1;::1",
      "KnownNetworks": null
    },
    "IpSafeList": {
      "IpAddresses": "127.0.0.1;::1",
      "IpNetworks": "192.168.1.0/24;2001:db8::/32"
    }
  }
}
